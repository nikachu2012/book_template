% ================================
% 各種設定値の定義
% ================================

% 余白
\def\topbottommargin{15truemm} % 上下の余白
\def\nodomargin{25truemm} % ノドの余白
\def\kogutimargin{15truemm} % 小口の余白
\newcommand{\mybookBleedSize}{3truemm} % 塗り足しの幅
\setlength{\footskip}{28pt}

% セクション
\newcommand{\mybooksecfont}{\sffamily\gtfamily\bfseries}
\newcommand{\mybooksubsubsecicon}{\small▶} % subsubsectionのアイコン(デフォルトでは右向き三角形)

% 色の定義
% 必ずCMYKを使用すること
\usepackage{xcolor}   % 色
\definecolor{mybooksourcebg}{cmyk}{0, 0, 0, 0.02} % ソースコードの背景
\definecolor{mybooksourceborder}{cmyk}{0, 0, 0, 0.4} % ソースコード枠

\definecolor{mybookmaincolor}{cmyk}{0.80, 0.35, 0.22, 0}
\definecolor{mybookwarncolor}{cmyk}{0.35, 1, 0.85, 0.02}
\definecolor{mybookcautioncolor}{cmyk}{0.36, 0.51, 1, 0}


\newcommand{\mybookmaincolor}{\color{mybookmaincolor}} % 全体のアクセントカラー

% ノンブルのスタイル
\newcommand{\mybookNombreStyle}{\ttfamily\fontsize{8}{9}\selectfont}

\usepackage{luacode} % Lua
\begin{luacode*}
    -- 32ビットパディングされた１６進文字列を返します
    function mybook_toHexString(number)
    tex.sprint(string.format("0x%08x", number))
    end
\end{luacode*}
\newcommand{\mybookNombreSecondLine}{\ttfamily\fontsize{8}{9}\selectfont\directlua{mybook_toHexString(\thepage)}}

% 目次
\newcommand{\mybooktoccolor}{\mybookmaincolor} % アクセント色

% ソースコード
% \renewcommand{\lstlistingname}{ソースコード}

% キャプション



% ================================
% 余白の指定
% ================================
\usepackage{calc}

\newlength{\vruledepth}% vruleの深さを定義(ノンブル真ん中から下)
\setlength{\vruledepth}{\topbottommargin - \footskip + \mybookBleedSize}

\setlength{\evensidemargin}{\kogutimargin - 1in}
\setlength{\oddsidemargin}{\nodomargin - 1in}

\setlength{\topmargin}{-1in} % 紙面の端から始めるようにする
\addtolength{\topmargin}{(\topbottommargin - \headheight) / 2}

\setlength{\headsep}{(\topbottommargin - \headheight) / 2}
\setlength{\textwidth}{\paperwidth - \nodomargin - \kogutimargin}
\setlength{\textheight}{\paperheight - \topbottommargin - \topbottommargin}


% ================================
% セクション
% ================================
\newcommand{\mybookhrulefill}[1]{\leavevmode\leaders\hrule height #1\hfill\kern\z@}
\makeatletter

% \chapter
\def\@makechapterhead#1{%
    \vspace*{0.5\Cvs}%
    {%
        \noindent%
        \hskip3mm\parbox[b]{15truemm}{\Huge\mybooksecfont\thechapter\hfill}\hfill%
        {\huge\mybooksecfont#1}%
        \par\nobreak%
    }%
    {\noindent\makebox[\linewidth+\kogutimargin+\mybookBleedSize+1cm]{\mybookmaincolor\mybookhrulefill{0.8mm}}\par\nobreak}
    {\vskip .5\Cvs}%
    \thispagestyle{mycustom}%
}

% \chapter* 
\def\@makeschapterhead#1{%
    \vspace*{0.5\Cvs}%
    {%
        \noindent%
        {\huge\mybooksecfont#1}%
        \par\nobreak%
    }%
    {\noindent\makebox[\linewidth+\kogutimargin+\mybookBleedSize+1cm]{\mybookmaincolor\mybookhrulefill{0.8mm}}\par\nobreak}
    {\vskip .5\Cvs}%
    \thispagestyle{mycustom}%
}

