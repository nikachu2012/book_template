\usepackage{listings,jvlisting}

\lstset{
    basicstyle={\ttfamily},
    identifierstyle={},
    commentstyle={\itshape},
    keywordstyle={\bfseries},
    ndkeywordstyle={},
    stringstyle={},
    breaklines=true,
    columns=[l]{fullflexible},
    numbers=left,
    xrightmargin=0\zw,
    xleftmargin=2\zw,
    numberstyle={\footnotesize\bfseries\color{mybooksourceborder}},
    stepnumber=1,
    numbersep=1\zw,
    lineskip=0.1ex,
    keepspaces=true
}
\renewcommand{\lstlistingname}{ソースコード}

\usepackage{tcolorbox} % ソースコードの枠
\tcbuselibrary{breakable} % tcolorbox内でページまたぎを有効にする
\tcbuselibrary{skins}

\lstnewenvironment{sourcecode}{}{} % sourcecode環境を定義

% sourcecode環境にtcolorboxを追加
% (texdocのtcolorboxenvironmentを参照)
\tcolorboxenvironment{sourcecode}{
    top=-2mm,%
    bottom=-2mm,%
    left=0mm,%
    right=4mm,%
    colback=mybooksourcebg,%
    colframe=mybooksourceborder,%
    boxrule=1pt,%
    breakable,%
    enhanced,
}

\newenvironment{codebox}{}{}
\tcolorboxenvironment{codebox}{
    top=-2mm,%
    bottom=-2mm,%
    left=0mm,%
    right=4mm,%
    colback=mybooksourcebg,%
    colframe=mybooksourceborder,%
    boxrule=1pt,%
    breakable,%
    enhanced,
}

