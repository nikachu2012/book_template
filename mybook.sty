\setlength\floatsep{10pt}

\setlength\intextsep{10pt}
\setlength\textfloatsep{10pt}

\setlength\abovecaptionskip{0pt}
\setlength\belowcaptionskip{0pt}

\makeatletter

% ================================
% 余白の指定
% ================================
\usepackage{calc}

\newlength{\vruledepth}% vruleの深さを定義(ノンブル真ん中から下)
\setlength{\vruledepth}{\topbottommargin - \footskip + \mybookBleedSize}

\setlength{\evensidemargin}{\kogutimargin - 1in}
\setlength{\oddsidemargin}{\nodomargin - 1in}

\setlength{\topmargin}{-1in} % 紙面の端から始めるようにする
\addtolength{\topmargin}{(\topbottommargin - \headheight) / 2}

\setlength{\headsep}{(\topbottommargin - \headheight) / 2}
\setlength{\textwidth}{\paperwidth - \nodomargin - \kogutimargin}
\setlength{\textheight}{\paperheight - \topbottommargin - \topbottommargin}


% ================================
% タイトルページ
% ================================
\renewcommand*{\date}[1]{\gdef\@date{#1}}

\usepackage{siunitx}
\sisetup{
    text-family-to-math = true,
    text-series-to-math = true
}
\gdef\@date{%
    \ttfamily%
    \num[minimum-integer-digits=4]{\number\year}-%
    \num[minimum-integer-digits=2]{\number\month}-%
    \num[minimum-integer-digits=2]{\number\day}%
}

\renewcommand{\maketitle}{%
    \begin{titlepage}%
        \parindent \z@
        % \reset@font
        \null\vfil
        \begin{flushleft}
            \mybooksecfont \Huge \@title
        \end{flushleft}
        \par
        {\mybookmaincolor\hrule height 0.8mm}
        \par
        \begin{flushright}
            \Large \@author \par
        \end{flushright}
        \vskip 60\p@
        \vfil\null
        \begin{flushright}
            {\small \@date}%
        \end{flushright}
    \end{titlepage}%
    \setcounter{footnote}{0}%
}


