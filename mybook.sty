% \section
\renewcommand{\section}[1]{%
    \vspace{1.5\Cvs}
    {\setlength\parskip{\z@}%
    \@startsection{section}{1}{\z@}%
    {\z@}% 前アキ
    {0.4\Cvs}% 後アキ
    {%
        \noindent{\mybookmaincolor\rule[-9pt]{2truemm}{1.9\Cvs}}%
        \hspace*{8pt}%
        \normalfont\Large\mybooksecfont%
    }[#1]{#1}\relax%
    {\vspace*{-1.5\Cwd}\noindent\mybookmaincolor\mybookhrulefill{0.4mm}}%
    {\vskip -0.1\Cvs}}%
}

% \subsection
\renewcommand{\subsection}[1]{
    \vspace{\Cvs \@plus.5\Cdp \@minus.2\Cdp}
    {\setlength\parskip{\z@}%
    \@startsection{subsection}{2}{\z@}%
    {\z@}% 前アキ
    {4pt}% 後アキ
    {%
        \noindent{\mybookmaincolor\rule[-7pt]{2truemm}{1.5\Cvs}}%
        \hspace*{8pt}%
        \normalfont\large\mybooksecfont
    }[#1]{#1}\relax%
    {\vspace*{-1.5\Cwd}\noindent\mybookmaincolor\mybookhrulefill{0.4mm}}%
    {\vskip -0.1\Cvs}}%
}

% \subsubsection
\usepackage{amssymb}
\renewcommand{\subsubsection}{%
    \vspace{2ex}
    \@startsection{subsubsection}{3}{\z@}%
    {\z@}%
    {\z@}%
    {%
        \setlength\parskip{\z@}%
        \normalfont\normalsize\headfont%
        {\mybookmaincolor\mybooksubsubsecicon}%
        \hspace{2pt}\mybooksecfont%
    }%
}

% ================================
% ヘッダとフッタ(柱とノンブル)
% ================================
\newcommand{\ps@mycustom}{%
    \renewcommand{\@oddhead}{% 左ページヘッダ
        \relax%
    }
    \renewcommand{\@evenhead}{% 左ページヘッダ
        \relax%
    }
    \renewcommand{\@oddfoot}{% 右ページフッタ
        \rightmark%
        \hfill% 右揃え
        \parbox[c]{30mm}{%
            \hfill{\mybookNombreStyle\thepage}%
            \@ifundefined{mybookNombreSecondLine}%
            {\relax}% ノンブル2行目が未定義の時
            {% ノンブル2行目が定義済みの時
                \\%
                \hfill\mybookNombreSecondLine%
            }%
        }%
        {\hskip2mm\mybookmaincolor\vrule height 16pt depth \vruledepth width 0.4truemm}%
    }
    \renewcommand{\@evenfoot}{% 左ページフッタ
        {\mybookmaincolor\vrule height 16pt depth \vruledepth width 0.4truemm\hskip2mm}%
        \parbox[c]{30mm}{%
            {\mybookNombreStyle\thepage}%
            \@ifundefined{mybookNombreSecondLine}%
            {\relax}% ノンブル2行目が未定義の時
            {% ノンブル2行目が定義済みの時
                \\%
                \mybookNombreSecondLine%
            }%
        }%
        \hfill%
        \leftmark%
    }
    \def\chaptermark##1{%
        \markboth{%
            \ifnum \c@secnumdepth >\m@ne%
                \if@mainmatter%
                    \if@omit@number\else%
                        {\mybookmaincolor\sffamily\gtfamily\bfseries\thechapter}\hskip1\zw%
                    \fi%
                \fi%
            \fi%
            ##1%
        }{}%
    }%
    \def\sectionmark##1{%
        \markright{%
            \ifnum \c@secnumdepth >\z@%
                {\mybookmaincolor\sffamily\gtfamily\bfseries\thesection}\hskip1\zw%
            \fi%
            ##1%
        }%
    }%
}

\pagestyle{mycustom}


