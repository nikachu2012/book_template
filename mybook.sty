\newcommand{\mybookhrulefill}[1]{\leavevmode\leaders\hrule height #1\hfill\kern\z@}

% \chapter
\def\@makechapterhead#1{%
    {\setlength\parskip{\z@}%
    \vspace*{0.5\Cvs}%
    {%
        \noindent%
        \hskip3mm\parbox[b]{15truemm}{\Huge\mybooksecfont\thechapter\hfill}\hfill%
        {\huge\mybooksecfont#1}%
        \par\nobreak%
    }%
    {\noindent\makebox[\linewidth+\kogutimargin+\mybookBleedSize]{\mybookmaincolor\mybookhrulefill{0.8mm}}\par\nobreak}
    % {\vskip .5\Cvs}%
    \thispagestyle{mycustom}}%
}

% \chapter* 
\def\@makeschapterhead#1{%
    {\setlength\parskip{\z@}%
    \vspace*{0.5\Cvs}%
    {%
        \noindent%
        {\huge\mybooksecfont#1}%
        \par\nobreak%
    }%
    {\noindent\makebox[\linewidth+\kogutimargin+\mybookBleedSize]{\mybookmaincolor\mybookhrulefill{0.8mm}}\par\nobreak}
    % {\vskip .5\Cvs}%
    \thispagestyle{mycustom}}%
}

